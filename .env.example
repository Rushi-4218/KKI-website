# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kki

# ---- Cloudinary (optional, for image uploads via admin panel) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Admin panel authentication (REQUIRED before deploying) ----
# The admin panel and all /api/admin/* routes are locked behind this
# single shared login. Choose a strong, unique password and a long
# random string for the session secret (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.kitchenkingindustries.in
